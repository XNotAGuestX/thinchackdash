{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["backend/**", "src/**", "mappings/**", "fixtures/datadog/integrations-core/postgres/**"],
        "maxDuration": 60
      }
    },
    { "src": "preview/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/", "dest": "/preview/index.html" },
    { "src": "/(.*)", "dest": "/preview/$1" }
  ]
}
